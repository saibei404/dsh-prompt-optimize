{
  "name": "dsh-prompt-optimize",
  "version": "1.1.1",
  "private": true,
  "description": "DSH 提示词优化（dsh-prompt-optimize）：DeepSeek Harness 提示词优化插件：在输入框旁加一个「✦ 优化提示词」按钮，把草稿改写成清晰、具体、可执行的提示词，成功后才覆盖草稿并可一键撤销。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saibei404/dsh-prompt-optimize.git"
  },
  "homepage": "https://github.com/saibei404/dsh-prompt-optimize#readme",
  "bugs": {
    "url": "https://github.com/saibei404/dsh-prompt-optimize/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md"],
  "keywords": ["deepseek", "deepseek-harness", "dsh", "dsh-plugin", "prompt", "prompt-engineering"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-primitives"]
    }
  },
  "engines": { "dsh": ">=0.2.0-rc.2 <0.3.0" }
}
